#!/usr/bin/env bash
#
# canon-webcam — usa uma DSLR Canon (testado em SL2 / EOS 200D) como webcam.
#
# Substitui os scripts antigos canon_webcam.sh, canon_webcam_optimized.sh
# e preVideo2.sh, que divergiam em device, flags de ffmpeg e tratamento de erro.
#
# Linux : gphoto2 -> ffmpeg -> v4l2loopback (/dev/videoN)
# macOS : gphoto2 -> ffmpeg -> stream local, consumido pelo OBS (ver docs/canon-sl2.md)
#
# Uso:
#   canon-webcam                 # detecta o melhor modo e transmite
#   canon-webcam --mode preview  # força capture-preview (mais compatível)
#   canon-webcam --mode movie    # força capture-movie (mais qualidade)
#   canon-webcam --check         # só diagnostica o ambiente e sai
#   canon-webcam --stop          # descarrega o v4l2loopback e libera a câmera
#
# Configurável por variável de ambiente (ver defaults abaixo).

set -euo pipefail

DEVICE_NR="${CANON_DEVICE_NR:-10}"
LABEL="${CANON_LABEL:-Canon_SL2}"
FPS="${CANON_FPS:-25}"
MAX_BUFFERS="${CANON_MAX_BUFFERS:-4}"
DETECT_TIMEOUT="${CANON_DETECT_TIMEOUT:-30}"
# Se o pipeline morre antes disso, consideramos que o modo não funcionou.
GRACE="${CANON_GRACE:-6}"
UDP_PORT="${CANON_UDP_PORT:-1234}"   # só macOS
LOGDIR="${CANON_LOGDIR:-${HOME}/.local/state/canon-webcam}"

MODE="auto"
ACTION="run"

OS="$(uname -s)"
DEVICE="/dev/video${DEVICE_NR}"

log()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --mode)   MODE="${2:?--mode exige preview|movie|auto}"; shift 2 ;;
    --device) DEVICE_NR="${2:?--device exige um número}"; DEVICE="/dev/video${DEVICE_NR}"; shift 2 ;;
    --check)  ACTION="check"; shift ;;
    --stop)   ACTION="stop"; shift ;;
    -h|--help) awk 'NR>1 && /^#/{sub(/^#[[:space:]]?/,""); print; next} NR>1{exit}' "$0"; exit 0 ;;
    *) die "argumento desconhecido: $1 (use --help)" ;;
  esac
done

case "$MODE" in auto|preview|movie) ;; *) die "modo inválido: $MODE" ;; esac

mkdir -p "$LOGDIR"
TS="$(date +%Y%m%d-%H%M%S)"

# ---------------------------------------------------------------- dependências

require() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' não encontrado. Rode o install.sh do repo."
}

check_deps() {
  require gphoto2
  require ffmpeg
  if [ "$OS" = "Linux" ]; then
    modinfo v4l2loopback >/dev/null 2>&1 \
      || die "módulo v4l2loopback ausente. Instale: sudo apt install v4l2loopback-dkms"
  fi
}

# ------------------------------------------------------------------- câmera

# O gvfs monta a câmera como storage e segura o acesso PTP, impedindo o gphoto2.
release_camera() {
  log "Liberando a câmera de processos do desktop..."
  for p in gvfsd-gphoto2 gvfs-gphoto2-volume-monitor gnome-photos shotwell; do
    pkill -f "$p" 2>/dev/null || true
  done
  sleep 0.5
}

wait_for_camera() {
  log "Procurando a câmera (até ${DETECT_TIMEOUT}s)..."
  local i
  for i in $(seq 1 "$DETECT_TIMEOUT"); do
    if gphoto2 --auto-detect 2>/dev/null | grep -qi canon; then
      log "Câmera detectada."
      return 0
    fi
    sleep 1
  done
  warn "Câmera não detectada. Confira:"
  warn "  - câmera ligada e com bateria"
  warn "  - seletor no modo de vídeo (movie)"
  warn "  - cabo USB de DADOS (muitos cabos são só de carga)"
  gphoto2 --auto-detect || true
  return 1
}

enable_liveview() {
  gphoto2 --set-config viewfinder=1 >/dev/null 2>&1 || true
}

# -------------------------------------------------------------- v4l2loopback

load_loopback() {
  log "Carregando v4l2loopback em ${DEVICE} (label: ${LABEL})..."
  sudo modprobe -r v4l2loopback 2>/dev/null || true
  sudo modprobe v4l2loopback \
    devices=1 \
    video_nr="$DEVICE_NR" \
    card_label="$LABEL" \
    exclusive_caps=1 \
    max_buffers="$MAX_BUFFERS" \
    || die "modprobe v4l2loopback falhou."

  # Os scripts antigos usavam o device imediatamente após o modprobe e às vezes
  # pegavam /dev/videoN ainda como root:root 0600 — o ffmpeg (que roda como
  # usuário) então falhava com "Permission denied" e o motivo não aparecia.
  udevadm settle --timeout=10 2>/dev/null || true

  local i
  for i in $(seq 1 20); do
    [ -w "$DEVICE" ] && { log "Dispositivo pronto: $(ls -l "$DEVICE")"; return 0; }
    sleep 0.25
  done

  warn "$(ls -l "$DEVICE" 2>&1)"
  die "sem permissão de escrita em ${DEVICE}.
    Instale a regra udev do repo e entre no grupo 'video':
      sudo install -m644 linux/files/etc/udev/rules.d/99-v4l2loopback-perms.rules /etc/udev/rules.d/
      sudo udevadm control --reload && sudo usermod -aG video \$USER
    (relogue depois de entrar no grupo)"
}

unload_loopback() {
  log "Descarregando v4l2loopback..."
  sudo modprobe -r v4l2loopback 2>/dev/null || true
}

# ------------------------------------------------------------------ pipelines

# Roda um pipeline e devolve 0 se ele sobreviveu ao período de graça.
# $1 = modo (preview|movie), $2 = arquivo de log
try_pipeline() {
  local mode="$1" logfile="$2"

  if [ "$OS" = "Linux" ]; then
    gphoto2 "--capture-${mode}" --stdout 2>>"$logfile" \
      | ffmpeg -hide_banner -loglevel error \
          -thread_queue_size 1024 \
          -fflags nobuffer -flags low_delay \
          -use_wallclock_as_timestamps 1 \
          -an -f mjpeg -i - \
          -pix_fmt yuv420p -r "$FPS" \
          -f v4l2 "$DEVICE" 2>>"$logfile" &
  else
    gphoto2 "--capture-${mode}" --stdout 2>>"$logfile" \
      | ffmpeg -hide_banner -loglevel error \
          -thread_queue_size 1024 \
          -fflags nobuffer -flags low_delay \
          -use_wallclock_as_timestamps 1 \
          -an -f mjpeg -i - \
          -pix_fmt yuv420p -r "$FPS" \
          -c:v mpeg2video -q:v 4 \
          -f mpegts "udp://127.0.0.1:${UDP_PORT}?pkt_size=1316" 2>>"$logfile" &
  fi

  PIPELINE_PGID=$!
  sleep "$GRACE"

  if kill -0 "$PIPELINE_PGID" 2>/dev/null; then
    return 0
  fi
  wait "$PIPELINE_PGID" 2>/dev/null || true
  return 1
}

stop_pipeline() {
  [ -n "${PIPELINE_PGID:-}" ] && kill "$PIPELINE_PGID" 2>/dev/null || true
  pkill -f 'gphoto2 --capture-' 2>/dev/null || true
}

# --------------------------------------------------------------------- ações

do_check() {
  log "Sistema: ${OS}"
  check_deps
  log "gphoto2: $(gphoto2 --version 2>/dev/null | head -1)"
  log "ffmpeg:  $(ffmpeg -version 2>/dev/null | head -1)"
  if [ "$OS" = "Linux" ]; then
    log "v4l2loopback: $(modinfo -F version v4l2loopback 2>/dev/null)"
    log "grupo video: $(id -nG | tr ' ' '\n' | grep -qx video && echo 'sim' || echo 'NÃO — veja o install.sh')"
    log "regra udev: $([ -f /etc/udev/rules.d/99-v4l2loopback-perms.rules ] && echo 'instalada' || echo 'AUSENTE')"
  fi
  release_camera
  gphoto2 --auto-detect || true
}

do_run() {
  check_deps
  release_camera
  wait_for_camera || exit 2
  enable_liveview

  [ "$OS" = "Linux" ] && load_loopback

  trap 'stop_pipeline; exit 0' INT TERM

  local modes
  case "$MODE" in
    auto)    modes="movie preview" ;;   # movie tem mais qualidade; preview é o fallback confiável
    movie)   modes="movie" ;;
    preview) modes="preview" ;;
  esac

  local chosen="" m logfile
  for m in $modes; do
    logfile="${LOGDIR}/${m}-${TS}.log"
    log "Tentando capture-${m}..."
    if try_pipeline "$m" "$logfile"; then
      chosen="$m"
      break
    fi
    warn "capture-${m} não sustentou o stream. Log: ${logfile}"
    stop_pipeline
    sleep 1
  done

  [ -n "$chosen" ] || die "nenhum modo funcionou. Logs em ${LOGDIR}
    Debug extra: env LANG=C gphoto2 --debug --debug-logfile=${LOGDIR}/gphoto-debug.txt --capture-movie"

  if [ "$OS" = "Linux" ]; then
    log "Transmitindo via capture-${chosen}. Selecione \"${LABEL}\" no Meet/Zoom/OBS."
  else
    log "Transmitindo via capture-${chosen} para udp://127.0.0.1:${UDP_PORT}"
    log "No OBS: adicione uma Media Source com esse URL (desmarque 'Local File')"
    log "e clique em Start Virtual Camera."
  fi
  log "Ctrl+C para parar."

  # Supervisiona: se o pipeline cair sozinho (câmera dorme, cabo encosta), reergue.
  logfile="${LOGDIR}/${chosen}-${TS}.log"
  while true; do
    wait "$PIPELINE_PGID" 2>/dev/null || true
    warn "Stream caiu. Reconectando em 2s..."
    sleep 2
    release_camera
    enable_liveview
    try_pipeline "$chosen" "$logfile" || warn "Falha ao reconectar; tentando de novo."
  done
}

case "$ACTION" in
  check) do_check ;;
  stop)  stop_pipeline; [ "$OS" = "Linux" ] && unload_loopback; log "Parado." ;;
  run)   do_run ;;
esac
