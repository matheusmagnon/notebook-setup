# If you change this file, or any file in /etc/default/grub.d/*.cfg,
# run 'update-grub' afterwards to update /boot/grub/grub.cfg.
# For full documentation on the options in these files, see
# 'info -f grub -n "Simple configuration"'

GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=hidden
GRUB_TIMEOUT=0
GRUB_DISTRIBUTOR=`( . /etc/os-release && echo ${NAME} )`
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash video=HDMI-A-1:2560x1080@60 zswap.enabled=1 zswap.compressor=zstd zswap.zpool=zsmalloc zswap.max_pool_percent=25"
GRUB_CMDLINE_LINUX=""

# If your computer has multiple operating systems installed, then you
# probably want to run os-prober. However, if your computer is a host
# for guest OSes installed via KVM, you may want to disable os-prober
# here. Commenting it out is a better approach:
#GRUB_DISABLE_OS_PROBER=false

# Uncomment to enable BadRAM filtering, modify to suit your needs
# This works with Linux (no patch required) and with any kernel that obtains
# the memory map information from the BIOS (GNU Mach, GNU coding kernels,
# FreeBSD, and LINUX) through the "e820" interface:
#GRUB_BADRAM="0x0123456789ABCDEF,0x1234567890ABCDEF"

# Uncomment to disable graphical terminal (grub-pc only)
#GRUB_TERMINAL=console

# The resolution used on graphical terminal
# note that you can use only modes which your graphic card supports via VBE
# you can see them in real GRUB with the command `vbeinfo'
#GRUB_GFXMODE=640x480

# Uncomment to get a beep at grub start
#GRUB_INIT_TUNE="480 440 1"
